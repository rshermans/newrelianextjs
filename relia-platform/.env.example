# =============================================================
# RELIA Platform — Variáveis de Ambiente
# Copie para .env e preencha os valores.
# =============================================================

# --- Base de Dados (Turso/libSQL) ---
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# OPENAI_REASONING_EFFORT=medium
# OPENAI_BASE_URL=                  # Para testes com servidor falso

# --- Preços IA (estimativa de custos, opcional) ---
# PRICE_IN_PER_M=
# PRICE_OUT_PER_M=

# --- Autenticação (Auth.js) ---
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true

# --- Administração ---
ADMIN_EMAILS=admin@example.com

# --- Wikimedia Commons (para testes) ---
# COMMONS_API_URL=

# --- Open Library (para testes) ---
# OPENLIBRARY_URL=

# --- FastAPI (agentes) ---
FASTAPI_URL=http://localhost:8000

# --- MCP Server ---
MCP_URL=http://localhost:8001

# --- Google Gemini (agentes FastAPI) ---
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Portas ---
# ALUNO_PORT=3000
# PROFESSOR_PORT=3001
# FASTAPI_PORT=8000
# MCP_PORT=8001
